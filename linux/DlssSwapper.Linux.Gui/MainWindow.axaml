<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DlssSwapper.Linux.Gui.MainWindow"
        Title="DLSS Swapper LLE"
        Icon="/Assets/icon_256.png"
        Width="800"
        Height="1040"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Grid Background="#202020">
    <!-- The page begins 56 DIPs from the window edge, matching the Windows
         shell's content padding and leaving the navigation card overlaid. -->
    <Grid Margin="56,0,0,0" RowDefinitions="Auto,*">
      <Grid Grid.Row="0"
            Margin="0,2,8,0"
            ColumnDefinitions="*,Auto"
            RowDefinitions="32,36,Auto">
        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    MinWidth="0"
                    Orientation="Horizontal"
                    Spacing="8">
          <TextBlock Text="Games"
                     VerticalAlignment="Center"
                     FontSize="24"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding VisibleGameCountText}"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="#C8C8C8" />
          <ProgressBar Width="20"
                       Height="3"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsBusy}"
                       VerticalAlignment="Center" />
          <TextBlock Text="{Binding HeaderStatusText}"
                     MaxWidth="210"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="#C8C8C8"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" />
        </StackPanel>

        <Grid Grid.Row="1"
              Grid.Column="0"
              Margin="0,3,8,1"
              MinWidth="0"
              MaxWidth="360"
              HorizontalAlignment="Stretch">
          <TextBox x:Name="SearchTextBox"
                   Classes="headerSearch"
                   AutomationProperties.Name="Search"
                   PlaceholderText="Search"
                   HorizontalAlignment="Stretch"
                   TextChanged="SearchTextBox_TextChanged" />
        </Grid>

        <StackPanel Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Height="64"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="3">
          <Button Classes="command" AutomationProperties.Name="Add Games">
            <Button.Content>
              <Grid RowDefinitions="22,24,10">
                <Path Grid.Row="0" Data="M12,3 V21 M3,12 H21" Classes="commandIcon" />
                <TextBlock Grid.Row="1" Text="Add&#x0a;Games" Classes="commandLabel" />
                <TextBlock Grid.Row="2" Text="⌄" FontSize="9" Foreground="#C8C8C8"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Button.Content>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Add one game" Click="AddOneGame_Click" />
                <MenuItem Header="Add separate games" Click="AddSeparateGames_Click" />
                <MenuItem Header="Add parent directory" Click="AddParentDirectory_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Classes="command"
                  AutomationProperties.Name="Deep Scan"
                  IsEnabled="{Binding CanInteract}"
                  Click="DeepScan_Click">
            <Grid RowDefinitions="22,24,10">
              <Path Grid.Row="0"
                    Data="M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 1 0 10.5,3 M16,16 L22,22"
                    Classes="commandIcon" />
              <TextBlock Grid.Row="1" Text="Deep&#x0a;Scan" Classes="commandLabel" />
            </Grid>
          </Button>

          <Button Classes="command"
                  AutomationProperties.Name="Refresh"
                  IsEnabled="{Binding CanInteract}"
                  Click="Refresh_Click">
            <Grid RowDefinitions="22,24,10">
              <Path Grid.Row="0" Data="M20,7 V12 H15 M20,12 A8,8 0 1 0 18.2,17.1"
                    Classes="commandIcon" />
              <TextBlock Grid.Row="1" Text="Refresh" Classes="commandLabel" />
              <TextBlock Grid.Row="2" Text="⌄" FontSize="9" Foreground="#C8C8C8"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Refresh" Click="Refresh_Click" />
                <MenuItem Header="Restore excluded Steam games" Click="RestoreExcluded_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Classes="command" AutomationProperties.Name="Batch" Click="Batch_Click">
            <Grid RowDefinitions="22,24,10">
              <Path Grid.Row="0"
                    Data="M4,6 L6,8 L9,4 M11,6 H21 M4,12 L6,14 L9,10 M11,12 H21 M4,18 L6,20 L9,16 M11,18 H21"
                    Classes="commandIcon" />
              <TextBlock Grid.Row="1" Text="Batch" Classes="commandLabel" />
              <TextBlock Grid.Row="2" Text="⌄" FontSize="9" Foreground="#C8C8C8"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Classes="command" AutomationProperties.Name="Filter">
            <Button.Content>
              <Grid RowDefinitions="22,24,10">
                <Path Grid.Row="0" Data="M3,4 H21 L14,12 V19 L10,21 V12 Z" Classes="commandIcon" />
                <TextBlock Grid.Row="1" Text="Filter" Classes="commandLabel" />
                <TextBlock Grid.Row="2" Text="⌄" FontSize="9" Foreground="#C8C8C8"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Button.Content>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="All games" Tag="0" Click="FilterMenu_Click" />
                <MenuItem Header="Steam" Tag="1" Click="FilterMenu_Click" />
                <MenuItem Header="Manually added" Tag="2" Click="FilterMenu_Click" />
                <MenuItem Header="DLSS" Tag="3" Click="FilterMenu_Click" />
                <MenuItem Header="Frame generation" Tag="4" Click="FilterMenu_Click" />
                <MenuItem Header="Ray reconstruction" Tag="5" Click="FilterMenu_Click" />
                <MenuItem Header="XeSS" Tag="6" Click="FilterMenu_Click" />
                <MenuItem Header="FSR" Tag="7" Click="FilterMenu_Click" />
                <MenuItem Header="Hidden" Tag="8" Click="FilterMenu_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Classes="command" AutomationProperties.Name="View">
            <Button.Content>
              <Grid RowDefinitions="22,24,10">
                <Path Grid.Row="0"
                      Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z"
                      Classes="commandIcon" />
                <TextBlock Grid.Row="1" Text="View" Classes="commandLabel" />
                <TextBlock Grid.Row="2" Text="⌄" FontSize="9" Foreground="#C8C8C8"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Button.Content>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Grid" Click="GridView_Click" />
                <MenuItem Header="List" Click="ListView_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Classes="command" AutomationProperties.Name="Sort">
            <Button.Content>
              <Grid RowDefinitions="22,24,10">
                <Path Grid.Row="0" Data="M8,4 V20 M4,8 L8,4 L12,8 M16,20 V4 M12,16 L16,20 L20,16"
                      Classes="commandIcon" />
                <TextBlock Grid.Row="1" Text="Sort" Classes="commandLabel" />
                <TextBlock Grid.Row="2" Text="⌄" FontSize="9" Foreground="#C8C8C8"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Button.Content>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Name" Tag="0" Click="SortMenu_Click" />
                <MenuItem Header="Source" Tag="1" Click="SortMenu_Click" />
                <MenuItem Header="DLL version" Tag="2" Click="SortMenu_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <Border Grid.Row="2"
                Grid.Column="0"
                IsVisible="{Binding HasAlert}"
                Background="#302610"
                BorderBrush="#725B22"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,5"
                Margin="0,4,8,4"
                MaxWidth="360"
                HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding AlertText}"
                       Foreground="#E7C66C"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="×"
                    Width="26"
                    Height="24"
                    MinHeight="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="Dismiss warning"
                    Click="DismissAlert_Click" />
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="1" RowDefinitions="32,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0"
              Width="360"
              HorizontalAlignment="Left"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0"
                     Text="Steam"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Border Grid.Column="1" Width="1" Height="18" Background="#666666"
                  Margin="7,0,7,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="Card size" FontSize="10" Foreground="#C8C8C8"
                     VerticalAlignment="Center" Margin="0,0,3,0" />
          <ComboBox x:Name="GridCardSizeInput"
                    Grid.Column="4"
                    AutomationProperties.Name="Grid card size"
                    Width="62" Height="28" MinHeight="28"
                    Padding="7,0,2,0"
                    SelectionChanged="GridCardSize_Changed" />

          <ComboBox x:Name="FilterComboBox" Grid.Column="2" IsVisible="False"
                    SelectedIndex="0" SelectionChanged="LibraryView_Changed">
            <ComboBoxItem Content="All games" />
            <ComboBoxItem Content="Steam" />
            <ComboBoxItem Content="Manually added" />
            <ComboBoxItem Content="DLSS" />
            <ComboBoxItem Content="Frame generation" />
            <ComboBoxItem Content="Ray reconstruction" />
            <ComboBoxItem Content="XeSS" />
            <ComboBoxItem Content="FSR" />
            <ComboBoxItem Content="Hidden" />
          </ComboBox>
          <ComboBox x:Name="SortComboBox" Grid.Column="4" IsVisible="False"
                    SelectedIndex="0" SelectionChanged="LibraryView_Changed">
            <ComboBoxItem Content="Name" />
            <ComboBoxItem Content="Source" />
            <ComboBoxItem Content="DLL version" />
          </ComboBox>
        </Grid>
        <Border Grid.Column="1"
                Width="324"
                IsVisible="{Binding IsBatchMode}"
                Opacity="0" />
        </Grid>

        <Border Grid.Row="0" BorderBrush="#424242" BorderThickness="0,0,0,1" />

        <ScrollViewer Grid.Row="1"
                      IsVisible="{Binding IsListView}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Games}" Margin="0,0,8,2">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="row" Height="42">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Launch" Tag="{Binding}" Click="GameLaunch_Click" />
                      <MenuItem Header="Notes" Tag="{Binding}" Click="GameNotes_Click" />
                      <MenuItem Header="History" Tag="{Binding}" Click="GameHistory_Click" />
                      <MenuItem Header="{Binding FavoriteActionText}" Tag="{Binding}" Click="GameFavorite_Click" />
                      <MenuItem Header="Reload" Tag="{Binding}" Click="GameReload_Click" />
                      <MenuItem Header="{Binding HideActionText}" Tag="{Binding}" Click="GameHide_Click" />
                      <MenuItem Header="Add custom cover" Tag="{Binding}" Click="GameCustomCover_Click" />
                      <MenuItem Header="Update detected DLLs to latest" Tag="{Binding}" Click="GameUpdateLatest_Click" />
                      <MenuItem Header="Remove" Tag="{Binding}" Click="GameRemove_Click" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="6">
                    <Border Grid.Column="0" Width="30" Height="40"
                            Background="#252525" BorderBrush="#424242"
                            BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                      <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                    </Border>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="5">
                      <TextBlock Text="{Binding FavoriteMarker}" Foreground="#F2C94C"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                    </Grid>
                    <TextBlock Grid.Column="2" Margin="0,0,8,0"
                               VerticalAlignment="Center" Foreground="#C8C8C8">
                      <Run Text="{Binding CardDllLabel}" /><Run Text=":  " />
                      <Run Text="{Binding CardDllVersion}" />
                    </TextBlock>
                    <CheckBox Grid.Column="0" Grid.ColumnSpan="3"
                              IsChecked="{Binding IsSelected}"
                              IsVisible="{Binding $parent[Window].DataContext.IsBatchMode}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1"
                      x:Name="GameGridViewport"
                      IsVisible="{Binding IsGridView}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PointerWheelChanged="GameGridViewport_PointerWheelChanged"
                      SizeChanged="GameGridViewport_SizeChanged">
          <ItemsControl ItemsSource="{Binding Games}" Margin="-1,0,7,2">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="gameCard"
                        Width="{Binding CardWidth}"
                        Height="{Binding CardHeight}">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Launch" Tag="{Binding}" Click="GameLaunch_Click" />
                      <MenuItem Header="Notes" Tag="{Binding}" Click="GameNotes_Click" />
                      <MenuItem Header="History" Tag="{Binding}" Click="GameHistory_Click" />
                      <MenuItem Header="{Binding FavoriteActionText}" Tag="{Binding}" Click="GameFavorite_Click" />
                      <MenuItem Header="Reload" Tag="{Binding}" Click="GameReload_Click" />
                      <MenuItem Header="{Binding HideActionText}" Tag="{Binding}" Click="GameHide_Click" />
                      <MenuItem Header="Add custom cover" Tag="{Binding}" Click="GameCustomCover_Click" />
                      <MenuItem Header="Update detected DLLs to latest" Tag="{Binding}" Click="GameUpdateLatest_Click" />
                      <MenuItem Header="Remove" Tag="{Binding}" Click="GameRemove_Click" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid Background="#252525" ClipToBounds="True">
                    <Grid>
                      <Image Source="/Assets/icon_256.png" Width="42" Height="42"
                             Opacity="0.12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                    </Grid>
                    <Border Padding="5,3"
                            VerticalAlignment="Bottom"
                            Background="#C0000000">
                      <Grid ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="5"
                            RowSpacing="1">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="{Binding Name}"
                                   MaxLines="2"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding CardDllLabel}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding CardDllVersion}"
                                   HorizontalAlignment="Right"
                                   FontSize="10" Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding FavoriteMarker}" Foreground="#F2C94C"
                               FontSize="16" HorizontalAlignment="Left"
                               VerticalAlignment="Top" Margin="5" />
                    <CheckBox IsChecked="{Binding IsSelected}"
                              IsVisible="{Binding $parent[Window].DataContext.IsBatchMode}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top" Margin="5" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Selection controls occupy the otherwise unused strip beneath the
         fixed right-side commands. They overlay rather than reflow the Steam
         heading, matching the approved Windows behavior. -->
    <Border IsVisible="{Binding IsBatchMode}"
            Background="#2B2B2B"
            BorderBrush="#444444"
            BorderThickness="1"
            CornerRadius="4"
            Padding="2"
            Margin="0,70,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            ZIndex="30">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="4">
        <TextBlock Grid.Column="0"
                   Text="{Binding SelectionHeading}"
                   Margin="3,0"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Select all" Height="26" MinHeight="26"
                Padding="8,0" Click="SelectAll_Click" />
        <Button Grid.Column="2" Content="Apply DLL" Height="26" MinHeight="26"
                Padding="8,0" Classes="primary" IsEnabled="{Binding CanActOnSelection}"
                Click="DllLibrary_Click" />
        <Button Grid.Column="3" Content="Remove" Height="26" MinHeight="26"
                Padding="8,0" IsEnabled="{Binding CanActOnSelection}"
                Click="RemoveSelected_Click" />
      </Grid>
    </Border>

    <Border Width="44"
            Height="86"
            Margin="4,4,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#2B2B2B"
            BorderBrush="#414141"
            BorderThickness="1"
            CornerRadius="5"
            ZIndex="20">
      <StackPanel Width="42" Height="84" VerticalAlignment="Center">
        <Button Classes="nav navSelected"
                ToolTip.Tip="Games"
                AutomationProperties.Name="Games">
          <Path Data="M4,8 C4,5.8 5.8,4 8,4 H16 C18.2,4 20,5.8 20,8 V16 C20,18.2 18.2,20 16,20 H8 C5.8,20 4,18.2 4,16 Z M8,10 V14 M6,12 H10 M15.5,10.5 H15.6 M17.5,13.5 H17.6"
                Classes="commandIcon" Width="18" Height="18" />
        </Button>
        <Button Classes="nav"
                ToolTip.Tip="DLL Library"
                AutomationProperties.Name="DLL Library"
                IsEnabled="{Binding CanInteract}"
                Click="DllLibrary_Click">
          <Path Data="M5,4 V20 M10,3 V19 M15,5 V21 M20,4 V20"
                Classes="commandIcon" Width="18" Height="18" />
        </Button>
        <Button Classes="nav"
                ToolTip.Tip="Settings"
                AutomationProperties.Name="Settings"
                IsEnabled="{Binding CanInteract}"
                Click="Settings_Click">
          <Path Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1"
                Classes="commandIcon" Width="18" Height="18" />
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
