<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)skiasharp.nativeassets.linux/3.119.4/LICENSE.txt" Link="Acknowledgements/SkiaSharp/license.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)skiasharp.nativeassets.linux/3.119.4/THIRD-PARTY-NOTICES.txt" Link="Acknowledgements/SkiaSharp/third-party-notices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.linux/8.3.1.3/LICENSE.txt" Link="Acknowledgements/HarfBuzzSharp/license.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.linux/8.3.1.3/THIRD-PARTY-NOTICES.txt" Link="Acknowledgements/HarfBuzzSharp/third-party-notices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.linux-x64/10.0.0/LICENSE.TXT" Link="Acknowledgements/.NET Runtime/license.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.linux-x64/10.0.0/THIRD-PARTY-NOTICES.TXT" Link="Acknowledgements/.NET Runtime/third-party-notices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/Acknowledgements/You/*" Link="Acknowledgements/You/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/Acknowledgements/DLSS/*" Link="Acknowledgements/DLSS/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/Acknowledgements/Streamline/*" Link="Acknowledgements/Streamline/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/Acknowledgements/FidelityFX-SDK/*" Link="Acknowledgements/FidelityFX-SDK/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/Acknowledgements/XeSS/*" Link="Acknowledgements/XeSS/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../src/Acknowledgements/YamlDotNet/*" Link="Acknowledgements/YamlDotNet/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Acknowledgements/**/*" Link="Acknowledgements/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="Acknowledgements/DLSS Swapper LLE/license.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dlss-swapper-linux-gui</AssemblyName>
    <Version>1.2.5.1</Version>
    <Product>DLSS Swapper LLE</Product>
    <Description>DLSS Swapper LLE Linux GUI checkpoint</Description>
    <RootNamespace>DlssSwapper.Linux.Gui</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LlePackageFormat" Value="$(LlePackageFormat)" />
    <AssemblyMetadata Include="LleSelfContained" Value="$(SelfContained)" />
    <AssemblyMetadata Include="LleRuntimeIdentifier" Value="$(RuntimeIdentifier)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DlssSwapper.Linux.Cli\DlssSwapper.Linux.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\src\Assets\icon_256.png" Link="Assets\icon_256.png" />
    <Content Include="..\..\src\Assets\static_manifest.json" Link="Assets\static_manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
