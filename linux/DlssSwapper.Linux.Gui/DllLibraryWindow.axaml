<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DlssSwapper.Linux.Gui.DllLibraryWindow"
        Title="DLL Library"
        Width="920"
        Height="680"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="18" RowSpacing="12">
    <StackPanel>
      <TextBlock Text="DLL Library" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Browse verified releases, manage the shared download cache, or apply one exact build to the selected games."
                 Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="220,*" ColumnSpacing="10">
      <ComboBox x:Name="FamilyComboBox" AutomationProperties.Name="DLL family"
                SelectionChanged="Filter_Changed" />
      <TextBox x:Name="SearchTextBox" Grid.Column="1" PlaceholderText="Search versions or build hashes"
               AutomationProperties.Name="Search DLL releases"
               TextChanged="Search_Changed" />
    </Grid>
    <Border Grid.Row="2" Classes="card">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="1.5*,1.05*,0.75*,0.7*,1*" ColumnSpacing="10" Margin="10,6">
          <TextBlock Text="Family" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Version" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="Build" FontWeight="SemiBold" />
          <TextBlock Grid.Column="3" Text="Size" FontWeight="SemiBold" />
          <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" />
        </Grid>
        <ListBox x:Name="EntryListBox"
                 Grid.Row="1"
                 AutomationProperties.Name="DLL releases"
                 SelectionChanged="EntrySelection_Changed">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="1.5*,1.05*,0.75*,0.7*,1*" ColumnSpacing="10" Margin="6">
                <TextBlock Text="{Binding Family}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Version}" />
                <TextBlock Grid.Column="2" Text="{Binding Build}" FontFamily="Monospace" />
                <TextBlock Grid.Column="3" Text="{Binding Size}" />
                <TextBlock Grid.Column="4" Text="{Binding Status}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <TextBlock x:Name="StatusText" Grid.Row="3" Text="Select a release." TextWrapping="Wrap" />
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <WrapPanel>
        <Button x:Name="DownloadButton" Content="Download selected" Margin="0,0,8,8" Click="Download_Click" />
        <Button x:Name="RemoveButton" Content="Remove downloaded" Margin="0,0,8,8" Click="Remove_Click" />
        <Button x:Name="DownloadLatestButton" Content="Download latest families" Margin="0,0,8,8" Click="DownloadLatest_Click" />
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="UseButton" Content="Use with selected games" Classes="primary" Click="Use_Click" />
        <Button Content="Close" Click="Close_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
