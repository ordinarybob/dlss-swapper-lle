<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DlssSwapper.Linux.Gui.StorageProfileDialog"
        Title="{DynamicResource ApplicationTitle}"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto">
    <StackPanel Grid.Row="0" Spacing="12" Margin="24,20,24,16">
      <TextBlock Text="{DynamicResource MainWindow_SystemPerformance_Title}"
                 FontSize="22"
                 FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource MainWindow_SystemPerformance_Message}"
                 TextWrapping="Wrap" />
      <CheckBox x:Name="HddModeCheckBox"
                Content="{DynamicResource MainWindow_SystemPerformance_HardDrive}" />
    </StackPanel>
    <Border Grid.Row="1"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource LleDividerBrush}"
            Padding="24,14">
      <Button Content="{DynamicResource General_Apply}"
              Classes="primary"
              MinWidth="120"
              HorizontalAlignment="Right"
              Click="Apply_Click" />
    </Border>
  </Grid>
</Window>
