<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DlssSwapper.Linux.Gui.ConfirmationDialog"
        Width="640"
        Height="520"
        MinWidth="440"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="22" RowDefinitions="*,Auto" RowSpacing="16">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
    <TextBlock x:Name="MessageText"
               TextWrapping="Wrap"
               FontSize="15" />
    <Border x:Name="WarningBorder"
            IsVisible="False"
            Background="{DynamicResource LleDangerSurfaceBrush}"
            BorderBrush="{DynamicResource LleDangerOutlineBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10">
      <TextBlock x:Name="WarningText"
                 Text="{DynamicResource Linux_Xaml_1}"
                 TextWrapping="Wrap" />
    </Border>
    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="{DynamicResource General_Cancel}"
              MinWidth="90"
              Click="Cancel_Click" />
      <Button Content="{DynamicResource Linux_Xaml_2}"
              MinWidth="90"
              Classes="danger"
              Click="Continue_Click" />
    </StackPanel>
  </Grid>
</Window>
