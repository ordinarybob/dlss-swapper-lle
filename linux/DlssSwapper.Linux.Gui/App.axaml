<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DlssSwapper.Linux.Gui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#202020" />
      <Setter Property="Foreground" Value="#F4F4F4" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, Sans" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#4F7DFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#9F3A45" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#292929" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="#292929" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#B7B7B7" />
    </Style>
    <Style Selector="Button.command">
      <Setter Property="Width" Value="58" />
      <Setter Property="Height" Value="76" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="#292929" />
      <Setter Property="BorderBrush" Value="#454545" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.command:pointerover">
      <Setter Property="Background" Value="#353535" />
      <Setter Property="BorderBrush" Value="#696969" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="22" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#353535" />
    </Style>
    <Style Selector="Button.navSelected">
      <Setter Property="Background" Value="#363636" />
      <Setter Property="BorderBrush" Value="#8B8B8B" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Border.gameCard">
      <Setter Property="Background" Value="#292929" />
      <Setter Property="BorderBrush" Value="#333333" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="TextBox.headerSearch">
      <Setter Property="Height" Value="46" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Background" Value="#2B2B2B" />
      <Setter Property="BorderBrush" Value="#454545" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Application.Styles>
</Application>
