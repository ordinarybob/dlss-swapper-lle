<Page
    x:Class="DLSS_Swapper.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:helpers="using:DLSS_Swapper.Helpers"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:system="using:System"
    xmlns:local="using:DLSS_Swapper"
    xmlns:ct_winui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    x:Name="RootPage">
    <Page.Resources>
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToNegationVisibilityConverter"  TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </Page.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="56,2,8,0">
            <TextBlock Text="{x:Bind ViewModel.TranslationProperties.PageTitle, Mode=OneWay}" TextWrapping="NoWrap" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />

            <!-- Needed to achieve parity in the looking with other pages -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <AppBarButton Label="" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="AdminInfoBar"
                 Grid.Row="1"
                 IsOpen="True"
                 Severity="Warning"
                 IsClosable="False"
                 Title="{x:Bind ViewModel.TranslationProperties.WarningText, Mode=OneWay}"
                 Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                 Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="56,0,56,56">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.ThemeModeText, Mode=OneWay}" />
                <StackPanel x:Name="ThemePanel" Margin="0,10,0,0">
                    <RadioButton x:Name="LightThemeRadioButton" GroupName="ThemeGroup" Tag="Light" IsChecked="{x:Bind ViewModel.LightThemeSelected, Mode=TwoWay}" Content="{x:Bind ViewModel.TranslationProperties.ThemeLightText, Mode=OneWay}" />
                    <RadioButton x:Name="DarkThemeRadioButton" GroupName="ThemeGroup" Tag="Dark" IsChecked="{x:Bind ViewModel.DarkThemeSelected, Mode=TwoWay}" Content="{x:Bind ViewModel.TranslationProperties.ThemeDarkText, Mode=OneWay}" />
                    <RadioButton x:Name="DefaultThemeRadioButton" GroupName="ThemeGroup" Tag="Default" IsChecked="{x:Bind ViewModel.DefaultThemeSelected, Mode=TwoWay}" Content="{x:Bind ViewModel.TranslationProperties.ThemeSystemSettingDefaultText, Mode=OneWay}" />
                </StackPanel>


                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.GameLibrariesText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0">
                    <usercontrols:GameLibrarySelectorControl />
                </StackPanel>

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="Performance" />
                <TextBlock
                    Margin="0,10,0,0"
                    TextWrapping="WrapWholeWords"
                    Text="These controls tune large-library throughput. Recommended defaults suit most systems. Scan and artwork worker changes apply after restarting the app; batch sizes and selected-game update concurrency apply to subsequent work." />
                <Grid Margin="0,18,0,0"
                      MaxWidth="840"
                      HorizontalAlignment="Left"
                      ColumnSpacing="16"
                      RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock x:Name="RecursiveScanLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Concurrent game scans" TextWrapping="WrapWholeWords" />
                        <TextBlock TextWrapping="WrapWholeWords" Text="Game folders scanned recursively at once (1–26). Recommended: 15; use 2 for a game library on a HDD." />
                    </StackPanel>
                    <usercontrols:PerformanceNumberEditor
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AccessibleName="{Binding Text, ElementName=RecursiveScanLabel}"
                        Minimum="1"
                        Maximum="26"
                        SmallChange="1"
                        Value="{x:Bind ViewModel.RecursiveScanConcurrency, Mode=TwoWay}" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CoverHydrationLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Concurrent artwork loading" TextWrapping="WrapWholeWords" />
                        <TextBlock TextWrapping="WrapWholeWords" Text="Game covers loaded in parallel after games appear (1–64). Recommended: 38; use 1 for a game library on a HDD." />
                    </StackPanel>
                    <usercontrols:PerformanceNumberEditor
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AccessibleName="{Binding Text, ElementName=CoverHydrationLabel}"
                        Minimum="1"
                        Maximum="64"
                        SmallChange="1"
                        Value="{x:Bind ViewModel.CoverHydrationConcurrency, Mode=TwoWay}" />

                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <TextBlock x:Name="UiBatchLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Games added per UI batch" TextWrapping="WrapWholeWords" />
                        <TextBlock TextWrapping="WrapWholeWords" Text="Games added to the interface before yielding to input and rendering (10–1000). Recommended: 550." />
                    </StackPanel>
                    <usercontrols:PerformanceNumberEditor
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AccessibleName="{Binding Text, ElementName=UiBatchLabel}"
                        Minimum="10"
                        Maximum="1000"
                        SmallChange="10"
                        Value="{x:Bind ViewModel.UiCollectionBatchSize, Mode=TwoWay}" />

                    <StackPanel Grid.Row="3" VerticalAlignment="Center">
                        <TextBlock x:Name="DatabaseBatchLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Database records per transaction" TextWrapping="WrapWholeWords" />
                        <TextBlock TextWrapping="WrapWholeWords" Text="Discovered game records committed per SQLite transaction (10–1000). Recommended: 550." />
                    </StackPanel>
                    <usercontrols:PerformanceNumberEditor
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AccessibleName="{Binding Text, ElementName=DatabaseBatchLabel}"
                        Minimum="10"
                        Maximum="1000"
                        SmallChange="10"
                        Value="{x:Bind ViewModel.DatabaseWriteBatchSize, Mode=TwoWay}" />

                    <StackPanel Grid.Row="4" VerticalAlignment="Center">
                        <TextBlock x:Name="BatchUpdateLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Concurrent game updates" TextWrapping="WrapWholeWords" />
                        <TextBlock TextWrapping="WrapWholeWords" Text="Games updated in parallel during a selected-games DLL update (1–26). Recommended: 15." />
                    </StackPanel>
                    <usercontrols:PerformanceNumberEditor
                        Grid.Row="4"
                        Grid.Column="1"
                        Width="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AccessibleName="{Binding Text, ElementName=BatchUpdateLabel}"
                        Minimum="1"
                        Maximum="26"
                        SmallChange="1"
                        Value="{x:Bind ViewModel.BatchSwapConcurrency, Mode=TwoWay}" />
                </Grid>
                <Button Margin="0,18,0,0"
                        Content="Reset recommended defaults"
                        Command="{x:Bind ViewModel.ResetPerformanceDefaultsCommand}" />

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="Fallback cover art" />
                <TextBlock
                    Margin="0,10,0,0"
                    MaxWidth="840"
                    HorizontalAlignment="Left"
                    TextWrapping="WrapWholeWords"
                    Text="Manually added games that do not resolve on Steam use this MediaWiki source. Only HTTPS portrait images from the allowed image host are accepted." />
                <TextBlock
                    Margin="0,16,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="MediaWiki API endpoint" />
                <TextBox
                    Margin="0,6,0,0"
                    MaxWidth="840"
                    HorizontalAlignment="Stretch"
                    Text="{x:Bind ViewModel.FallbackCoverArtApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Allowed image host" />
                <TextBox
                    Margin="0,6,0,0"
                    MaxWidth="840"
                    HorizontalAlignment="Stretch"
                    Text="{x:Bind ViewModel.FallbackCoverArtImageHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="Save source"
                        Command="{x:Bind ViewModel.SaveFallbackCoverArtSourceCommand}" />
                    <Button
                        Content="Reset default"
                        Command="{x:Bind ViewModel.ResetFallbackCoverArtSourceCommand}" />
                </StackPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.FallbackCoverArtSourceError, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="Fast scan paths" />
                <TextBlock
                    Margin="0,10,0,0"
                    MaxWidth="840"
                    HorizontalAlignment="Left"
                    TextWrapping="WrapWholeWords"
                    Text="The fast scan checks these relative directory patterns for supported DLLs. Deep Scan automatically learns newly discovered layouts; you can also add or remove a pattern here. Use * to match exactly one directory level." />
                <Expander
                    Margin="0,12,0,0"
                    MaxWidth="840"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Built-in patterns">
                    <ListView
                        MaxHeight="280"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.BuiltInGameAssetDirectoryPatterns, Mode=OneTime}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    FontFamily="Consolas"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
                <TextBlock
                    Margin="0,18,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Learned and custom patterns" />
                <Grid
                    Margin="0,8,0,0"
                    MaxWidth="840"
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        PlaceholderText="Example: Engine\Plugins\MyUpscaler\Binaries\Win64"
                        Text="{x:Bind ViewModel.NewGameAssetDirectoryPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Command="{x:Bind ViewModel.AddGameAssetDirectoryPatternCommand}"
                        Content="Add pattern" />
                </Grid>
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.GameAssetDirectoryPatternError, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ListView
                    Margin="0,6,0,0"
                    MaxWidth="840"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.CustomGameAssetDirectoryPatterns, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteGameAssetDirectoryPatternCommand}"
                                    CommandParameter="{Binding}"
                                    Content="Remove" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="Games grid" />
                <TextBlock
                    Margin="0,10,0,0"
                    TextWrapping="WrapWholeWords"
                    Text="Grid cards resize to fill the available width at a 2:3 cover ratio, so no space is reserved at the right edge. These preferences guide how dense the grid is." />
                <Grid Margin="0,18,0,0"
                      MaxWidth="840"
                      HorizontalAlignment="Left"
                      ColumnSpacing="16"
                      RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock x:Name="GridColumnsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Preferred columns" TextWrapping="WrapWholeWords" />
                        <TextBlock TextWrapping="WrapWholeWords" Text="Minimum card columns in grid view (1–16). Ctrl + mouse wheel over the grid also changes this. Recommended: 6." />
                    </StackPanel>
                    <usercontrols:PerformanceNumberEditor
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AccessibleName="{Binding Text, ElementName=GridColumnsLabel}"
                        Minimum="1"
                        Maximum="16"
                        SmallChange="1"
                        Value="{x:Bind ViewModel.GridViewPreferredColumns, Mode=TwoWay}" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="GridRowsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Preferred visible rows" TextWrapping="WrapWholeWords" />
                        <TextBlock TextWrapping="WrapWholeWords" Text="Card rows kept in view when the window is short; extra columns are added if needed (1–10). Recommended: 3." />
                    </StackPanel>
                    <usercontrols:PerformanceNumberEditor
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="112"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AccessibleName="{Binding Text, ElementName=GridRowsLabel}"
                        Minimum="1"
                        Maximum="10"
                        SmallChange="1"
                        Value="{x:Bind ViewModel.GridViewPreferredRows, Mode=TwoWay}" />
                </Grid>

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.IgnoredPathsText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Resources>
                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                        <x:Double x:Key="CornerRadius">0</x:Double>
                        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                        <Thickness x:Key="ExpanderHeaderPadding">0,0,0,0</Thickness>
                    </StackPanel.Resources>

                    <Button Content="{x:Bind ViewModel.TranslationProperties.AddIgnoredPathText, Mode=OneWay}" Command="{x:Bind ViewModel.AddIgnoredPathCommand}" />

                    <ListView ItemsSource="{x:Bind ViewModel.IgnoredPaths}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Expander
                                    ExpandDirection="Down"
                                    HorizontalAlignment="Stretch"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    HorizontalContentAlignment="Stretch"
                                    >
                                    <Expander.Header>
                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <Expander.Content>
                                        <Grid HorizontalAlignment="Right">
                                            <Button Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteIgnoredPathCommand}" CommandParameter="{x:Bind }">Remove</Button>
                                        </Grid>
                                    </Expander.Content>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                       Margin="0,40,0,0" Spacing="10">
                    <TextBlock
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{x:Bind ViewModel.TranslationProperties.DLSSOptionsText, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Header="{x:Bind ViewModel.TranslationProperties.DLSSOptionsGlobalPresetText, Mode=OneWay}" IsEnabled="{x:Bind helpers:NVAPIHelper.Instance.IsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.DlssPresetOptions, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.SelectedGlobalDlssPreset, Mode=TwoWay}" DisplayMemberPath="Name" />
                        <Button Visibility="{x:Bind helpers:NVAPIHelper.Instance.PermissionIssue, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" Command="{x:Bind ViewModel.NVAPIErrorCommand, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.NVAPIErrorTooltipText, Mode=OneWay}" Style="{StaticResource TextBlockButtonStyle}" VerticalAlignment="Bottom">
                            <Button.Content>
                                <FontIcon Style="{StaticResource ErrorFontIcon}" />
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <ComboBox Header="{x:Bind ViewModel.TranslationProperties.DLSSDOptionsGlobalPresetText, Mode=OneWay}" IsEnabled="{x:Bind helpers:NVAPIHelper.Instance.IsSupported, Mode=OneTime}" ItemsSource="{x:Bind ViewModel.DlssDPresetOptions, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.SelectedGlobalDlssDPreset, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,8" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <ComboBox Header="{x:Bind ViewModel.TranslationProperties.DLSSGOptionsGlobalPresetText, Mode=OneWay}" IsEnabled="{x:Bind helpers:NVAPIHelper.Instance.IsSupported, Mode=OneTime}" ItemsSource="{x:Bind ViewModel.DlssGPresetOptions, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.SelectedGlobalDlssGPreset, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,8" />
                </StackPanel>

                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" FontStyle="Italic" Margin="0,8,0,0">
                        <Run Text="{x:Bind ViewModel.TranslationProperties.DLSSPresetInfoTooltipText, Mode=OneWay}" /> <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.DLSSPresetInfoCommand}"><Run Text="{x:Bind ViewModel.TranslationProperties.DLSSPresetInfoText, Mode=OneWay}" /></Hyperlink>.
                </TextBlock>


                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.DLSSDeveloperOptionsText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0">
                    <ComboBox Header="{x:Bind ViewModel.TranslationProperties.ShowOnScreenIndicatorText, Mode=OneWay}" ItemsSource="{Binding DLSSOnScreenIndicatorOptions, Mode=OneTime}" SelectedItem="{Binding SelectedDlssOnScreenIndicator, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,0,0,8" />
                    <CheckBox Content="{x:Bind ViewModel.TranslationProperties.EnableLoggingToFileText, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DlssEnableLogging, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="{x:Bind ViewModel.TranslationProperties.VerboseLoggingText, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DlssVerboseLogging, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.DlssEnableLogging, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="{x:Bind ViewModel.TranslationProperties.EnableLoggingToConsoleWindowText, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DlssLoggingToWindow, Mode=TwoWay}"  Margin="0,0,0,4"/>
                </StackPanel>


                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.AllowUntrustedText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AllowUntrusted, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Bind ViewModel.TranslationProperties.AllowUntrustedInfo, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontStyle="Italic" Margin="0,8,0,0" />
                </StackPanel>


                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.AllowDebugDllsText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AllowDebugDlls, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Bind ViewModel.TranslationProperties.AllowDebugDllsInfo, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontStyle="Italic" Margin="0,8,0,0" />
                </StackPanel>


                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.ShowOnlyDownloadedDllsText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.OnlyShowDownloadedDlls, Mode=TwoWay}" OffContent="{x:Bind ViewModel.TranslationProperties.NoText, Mode=OneWay}" OnContent="{x:Bind ViewModel.TranslationProperties.YesText, Mode=OneWay}" Margin="0,0,0,4" />
                    <TextBlock Text="{x:Bind ViewModel.TranslationProperties.ApliesOnlyToDllPickerNotLibraryText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontStyle="Italic" Margin="0,8,0,0" />
                </StackPanel>


                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.NetworkingText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0">
                    <Button Content="{x:Bind ViewModel.TranslationProperties.ProxySettingsText, Mode=OneWay}" Command="{x:Bind ViewModel.OpenProxySettingsCommand}" Margin="0,0,0,4" />
                </StackPanel>


                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.LoggingText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0">
                    <ComboBox x:Name="LoggingComboBox" ItemsSource="{x:Bind ViewModel.LoggingLevelOptions}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.LoggingLevel, Mode=TwoWay}" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" FontStyle="Italic" Margin="0,8,0,0">
                        <Run Text="{x:Bind ViewModel.TranslationProperties.YourCurrentLogfileText, Mode=OneWay}" /><Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenLogFileCommand}"><Run Text="{x:Bind ViewModel.CurrentLogPath}" /></Hyperlink>.
                    </TextBlock>
                </StackPanel>

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.LanguageText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0" Spacing="8">
                    <ComboBox x:Name="LanguageComboBox" ItemsSource="{x:Bind ViewModel.Languages}" DisplayMemberPath="Value" SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                    <Button Content="{x:Bind ViewModel.TranslationProperties.OpenTranslationToolboxText, Mode=OneWay}" Command="{x:Bind ViewModel.OpenTranslationToolboxCommand}" />
                </StackPanel>

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.AboutText, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Visibility="{x:Bind local:BuildInfo.IsFromTagBuild, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="{x:Bind ViewModel.TranslationProperties.VersionText, Mode=OneWay}" FontWeight="Bold" />
                        <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenVersionCommand}" >
                            <Run Text="{x:Bind ViewModel.AppVersion}" />
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Visibility="{x:Bind local:BuildInfo.IsFromTagBuild, Converter={StaticResource BoolToNegationVisibilityConverter}}">
                        <Run Text="{x:Bind ViewModel.TranslationProperties.VersionText, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="{x:Bind ViewModel.AppVersion}" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Visibility="{x:Bind local:BuildInfo.IsFromTagBuild, Converter={StaticResource BoolToNegationVisibilityConverter}}">
                    <Run Text="{x:Bind ViewModel.TranslationProperties.BuildCommitText, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="{x:Bind local:BuildInfo.GitCommitShort}" />
                    <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.CopyGitCommitCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.CopyText, Mode=OneWay}" FontStyle="Normal" FontSize="12">
                        <Run Text="&#xE8C8;" FontFamily="/Assets/Fonts/Segoe-Fluent-Icons.ttf#Segoe Fluent Icons" />
                    </Hyperlink>
                </TextBlock>

                <TextBlock>
                    <Run Text="{x:Bind ViewModel.TranslationProperties.BuildDateText, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="{x:Bind local:BuildInfo.BuildDateTimeFormattedString}" />
                </TextBlock>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0" Spacing="16" >
                    <Button Content="{x:Bind ViewModel.TranslationProperties.CheckForUpdatesText, Mode=OneWay}" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                    <ProgressRing Width="25" Height="25" IsIndeterminate="True" IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}" />
                </StackPanel>

                <RichTextBlock Margin="0,24,0,0">
                    <Paragraph Margin="0,12,0,0">
                        GitHub:
                        <Hyperlink NavigateUri="https://github.com/beeradmoore/dlss-swapper">beeradmoore/dlss-swapper</Hyperlink>
                    </Paragraph>
                    <Paragraph Margin="0,0,0,0">
                        Twitter:
                        <Hyperlink NavigateUri="https://twitter.com/dlss_swapper">@dlss_swapper</Hyperlink>
                    </Paragraph>
                    <Paragraph Margin="0,0,0,0">
                        Reddit:
                        <Hyperlink NavigateUri="https://www.reddit.com/r/DLSS_Swapper/">r/DLSS_Swapper</Hyperlink>
                    </Paragraph>
                    <Paragraph Margin="0,12,0,0">
                        <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenAcknowledgementsCommand}">
                            <Run Text="{x:Bind ViewModel.TranslationProperties.AcknowledgementsText, Mode=OneWay}" />
                        </Hyperlink>
                    </Paragraph>
                </RichTextBlock>

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.GiveFeedbackText, Mode=OneWay}" />
                <RichTextBlock Margin="0,12,0,0">
                    <Paragraph>
                        <Run Text="{x:Bind ViewModel.TranslationProperties.GiveFeedbackInfo, Mode=OneWay}" />
                        <Hyperlink NavigateUri="https://github.com/beeradmoore/dlss-swapper/issues">GitHub repository</Hyperlink>
                    </Paragraph>
                </RichTextBlock>

                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,40,0,0"
                    Text="{x:Bind ViewModel.TranslationProperties.TroubleshootingText, Mode=OneWay}" />
                <StackPanel Margin="0,10,0,0" Orientation="Vertical">
                    <RichTextBlock>
                        <Paragraph Margin="0,12,0,0">
                            <Hyperlink NavigateUri="https://github.com/beeradmoore/dlss-swapper/wiki/Troubleshooting">
                                <Run Text="{x:Bind ViewModel.TranslationProperties.GeneralTroubleshootingGuideText, Mode=OneWay}" />
                            </Hyperlink>
                        </Paragraph>
                        <Paragraph Margin="0,12,0,0">
                            <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenNetworkTesterCommand}">
                                <Run Text="{x:Bind ViewModel.TranslationProperties.NetworkTesterText, Mode=OneWay}" />
                            </Hyperlink>
                        </Paragraph>
                        <Paragraph Margin="0,12,0,0">
                            <Hyperlink ct_winui:HyperlinkExtensions.Command="{x:Bind ViewModel.OpenDiagnosticsCommand}">
                                <Run Text="{x:Bind ViewModel.TranslationProperties.DiagnosticsText, Mode=OneWay}" />
                            </Hyperlink>
                        </Paragraph>
                    </RichTextBlock>

                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="0,24,0,0"
                        Text="Reset local app data" />
                    <TextBlock
                        Margin="0,6,0,0"
                        MaxWidth="680"
                        HorizontalAlignment="Left"
                        TextWrapping="Wrap"
                        Text="Erase all local DLSS Swapper data and restart at the first-run performance selector. Game installations and .dlsss backups are not changed." />
                    <Button
                        Margin="0,12,0,0"
                        Content="Reset all local app data"
                        Command="{x:Bind ViewModel.ResetLocalAppDataCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
