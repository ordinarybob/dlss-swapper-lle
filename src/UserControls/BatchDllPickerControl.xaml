<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.BatchDllPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    mc:Ignorable="d"
    MinWidth="420">

    <StackPanel Spacing="12">
        <StackPanel Spacing="6">
            <Button
                HorizontalAlignment="Left"
                Style="{ThemeResource AccentButtonStyle}"
                Content="{x:Bind ViewModel.TranslationProperties.UpdateDetectedDllsToLatestText, Mode=OneWay}"
                Command="{x:Bind ViewModel.UpdateDetectedDllsToLatestCommand}"
                AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.UpdateDetectedDllsToLatestText, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.TranslationProperties.UpdateDetectedDllsDescriptionText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer
            MaxHeight="420"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <ItemsControl
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="usercontrols:BatchDllRowModel">
                        <Grid
                            Padding="0,3"
                            ColumnSpacing="12"
                            HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind TypeName}"
                                TextWrapping="Wrap" />

                            <ComboBox
                                Grid.Column="1"
                                MinWidth="240"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind TypeName}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind DllOptions}"
                                SelectedItem="{x:Bind SelectedDllOption, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
