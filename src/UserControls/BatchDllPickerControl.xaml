<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.BatchDllPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    mc:Ignorable="d"
    MinWidth="420">

    <UserControl.Resources>
        <ct_converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"
            TrueValue="Visible"
            FalseValue="Collapsed" />
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <Button
                HorizontalAlignment="Left"
                Style="{ThemeResource AccentButtonStyle}"
                Content="{x:Bind ViewModel.TranslationProperties.UpdateDetectedDllsToLatestText, Mode=OneWay}"
                Command="{x:Bind ViewModel.UpdateDetectedDllsToLatestCommand}"
                AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.UpdateDetectedDllsToLatestText, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.TranslationProperties.UpdateDetectedDllsDescriptionText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <CheckBox Content="Include Streamline updates (experimental)"
                  IsChecked="{x:Bind ViewModel.IncludeStreamline, Mode=TwoWay}" />
        <Button Grid.Column="1" Content="Components…" IsEnabled="{x:Bind ViewModel.IncludeStreamline, Mode=OneWay}">
            <Button.Flyout>
                <Flyout>
                    <StackPanel Width="300" Spacing="8">
                        <TextBlock Text="Streamline components" FontWeight="SemiBold" />
                        <TextBlock Text="Only installed components are updated. Originals are retained." TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.StreamlineRows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="usercontrols:BatchStreamlineRowModel">
                                        <CheckBox Content="{x:Bind FileName}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="{x:Bind Description}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
        </Grid>
        <Border Grid.Row="2" MinHeight="36">
        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IncludeStreamline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
        <ComboBox Header="Streamline SDK version" ItemsSource="{x:Bind ViewModel.StreamlineVersions}" SelectedItem="{x:Bind ViewModel.SelectedStreamlineRelease, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
        <TextBlock Text="{x:Bind ViewModel.StreamlineStatus, Mode=OneWay}" TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.IncludeStreamline, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        </StackPanel>
        </Border>
        <ScrollViewer
            Grid.Row="3"
            MaxHeight="480"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="12">
                <ItemsControl
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="usercontrols:BatchDllRowModel">
                            <Grid
                                Padding="0,3"
                                ColumnSpacing="12"
                                HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind TypeName}"
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="240"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind TypeName}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind DllOptions}"
                                    SelectedItem="{x:Bind SelectedDllOption, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.HasPresetRows, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneTime}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.TranslationProperties.NvidiaPresetsText, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.TranslationProperties.NvidiaPresetsDescriptionText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ItemsControl
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.PresetRows, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasPresetRows, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="usercontrols:BatchPresetRowModel">
                            <Grid
                                Padding="0,3"
                                ColumnSpacing="12"
                                HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind PresetName}"
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="240"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind PresetName}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind PresetOptions}"
                                    SelectedItem="{x:Bind SelectedPresetOption, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
