<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DLSS_Swapper.UserControls.BatchSwapSummaryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    MinWidth="400">

    <UserControl.Resources>
        <ct_converters:StringVisibilityConverter
            x:Key="StringVisibilityConverter"
            EmptyValue="Collapsed"
            NotEmptyValue="Visible" />
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Click="CopyAllButton_Click"
                Content="{x:Bind ViewModel.TranslationProperties.CopyAllText, Mode=OneWay}" />
            <Button
                x:Name="SaveReportButton"
                Click="SaveReportButton_Click"
                Content="{x:Bind ViewModel.TranslationProperties.SaveReportText, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            x:Name="FeedbackInfoBar"
            IsClosable="True"
            IsOpen="False" />

        <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap">
            <Run
                FontWeight="Bold"
                Text="{x:Bind ViewModel.TranslationProperties.SwappedText, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{x:Bind ViewModel.SwappedCount, Mode=OneTime}" />
        </TextBlock>
        <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap">
            <Run
                FontWeight="Bold"
                Text="{x:Bind ViewModel.TranslationProperties.PresetsAppliedText, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{x:Bind ViewModel.PresetsAppliedCount, Mode=OneTime}" />
        </TextBlock>
        <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap">
            <Run
                FontWeight="Bold"
                Text="{x:Bind ViewModel.TranslationProperties.AlreadyCurrentText, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{x:Bind ViewModel.AlreadyCurrentCount, Mode=OneTime}" />
        </TextBlock>
        <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap">
            <Run
                FontWeight="Bold"
                Text="{x:Bind ViewModel.TranslationProperties.SkippedText, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{x:Bind ViewModel.SkippedCount, Mode=OneTime}" />
        </TextBlock>
        <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap">
            <Run
                FontWeight="Bold"
                Text="{x:Bind ViewModel.TranslationProperties.ErrorsText, Mode=OneWay}" />
            <Run Text=" " />
            <Run Text="{x:Bind ViewModel.ErrorCount, Mode=OneTime}" />
        </TextBlock>

        <TextBlock
            IsTextSelectionEnabled="True"
            Text="{x:Bind ViewModel.AdminMessage, Mode=OneTime}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.AdminMessage, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />

        <TextBox
            AcceptsReturn="True"
            AutomationProperties.Name="{x:Bind ViewModel.TranslationProperties.ResultsText, Mode=OneWay}"
            Header="{x:Bind ViewModel.TranslationProperties.ResultsText, Mode=OneWay}"
            IsReadOnly="True"
            IsSpellCheckEnabled="False"
            MaxHeight="300"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Text="{x:Bind ViewModel.ResultsText, Mode=OneTime}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ResultsText, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
    </StackPanel>
</UserControl>
